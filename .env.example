# Copy to .env and fill in. Supabase → Settings → API.
#
# The anon key is public by design — it ships in the browser bundle and grants
# nothing on its own. Row-level security in supabase/schema.sql is the actual
# lock. See ACCESS.md.
#
# NEVER put the service_role key here. It bypasses every policy.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Comma-separated. Emails that see edit controls. Cosmetic — the server-side
# rule lives in schema.sql and must list the same addresses.
VITE_OWNER_EMAILS=you@example.com
